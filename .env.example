# ════════════════════════════════════════════
# SaaS Growth Agent — Environment Variables
# ════════════════════════════════════════════

# Database (Supabase PostgreSQL or Local Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Redis (Caching & Job Queues)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="saas-growth-agent-dev-secret-change-in-production"

# App
NODE_ENV="development"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@saasgrowth.internal"
ADMIN_PASSWORD="AdminSecurePassword123!"

# ────────────────────────────────────────────
